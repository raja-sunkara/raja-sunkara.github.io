@inproceedings{sunkara2025adaptive,
  abbr={ICML},
  title={Adaptive Partitioning Schemes for Optimistic Optimization},
  author={Sunkara, Raja and Tripathy, Ardhendu},
  booktitle={Proceedings of the 42nd International Conference on Machine Learning},
  series={Proceedings of Machine Learning Research},
  volume={267},
  pages={58029--58064},
  year={2025},
  publisher={PMLR},
  abstract={Applications such as engineering design often require us to optimize a black-box function, i.e., a system whose inner processing is not analytically known and whose gradients are not available. Practitioners often have a fixed budget for the number of function evaluations and the performance of an optimization algorithm is measured by its simple regret. In this paper, we study the class of "Optimistic Optimization" algorithms for black-box optimization that use a partitioning scheme for the domain. We develop algorithms that learn a good partitioning scheme and use flexible surrogate models such as neural networks in the optimization procedure. For multi-index functions on an $m$-dimensional subspace within $d$ dimensions, our algorithm attains $\tilde{O}(n^{-\beta / d})$ regret, where $\beta = 1 + \frac{d-m}{2m-1}$, as opposed to $\tilde{O}(n^{-1/d})$ for SequOOL, a state-of-the-art optimistic optimization algorithm. Our approach is competitive across a wide range of numerical benchmarks. Additionally, we introduce weight quantization in a large language model as a novel task for black-box optimization.},
  arxiv={2610.04039},
  pdf={https://raw.githubusercontent.com/mlresearch/v267/main/assets/sunkara25a/sunkara25a.pdf},
  code={https://github.com/raja-sunkara/Learned-Partitions-SequOOL},
  website={https://raja-sunkara.github.io/Learned-Partitions-SequOOL/},
  html={https://proceedings.mlr.press/v267/sunkara25a.html},
  preview={adaptive_partitioning.png},
  google_scholar_id={sNmaIFBj_lkC},
  bibtex_show={true},
  selected={true}
}

@article{sunkara2023yoga,
  abbr={Pattern Recognition},
  title={{YOGA}: Deep Object Detection in the Wild with Lightweight Feature Learning and Multiscale Attention},
  author={Sunkara, Raja and Luo, Tie},
  journal={Pattern Recognition},
  volume={139},
  pages={109451},
  year={2023},
  publisher={Elsevier},
  doi={10.1016/j.patcog.2023.109451},
  abstract={YOGA is a deep-learning object detector built to run on low-end edge devices while staying accurate. Its backbone, CSPGhostNet, learns half of each layer's feature maps with ordinary convolutions and produces the other half with cheap linear operations, which roughly halves the number of filters. Its neck, AFF-PANet, fuses features across scales with attentional feature fusion instead of plain concatenation. On COCO-val and COCO-testdev, compared with more than ten state-of-the-art detectors, YOGA gives the best trade-off between model size and accuracy: up to 22% higher AP with 23–34% fewer parameters and FLOPs. It also runs in real time on an NVIDIA Jetson Nano.},
  arxiv={2307.05945},
  code={https://github.com/TrustAIoT/YOGA_object-detection},
  preview={yoga.png},
  bibtex_show={true},
  selected={true}
}

@inproceedings{sunkara2022no,
  abbr={ECML-PKDD},
  title={No More Strided Convolutions or Pooling: A New {CNN} Building Block for Low-Resolution Images and Small Objects},
  author={Sunkara, Raja and Luo, Tie},
  booktitle={Joint European Conference on Machine Learning and Knowledge Discovery in Databases (ECML PKDD)},
  series={Lecture Notes in Computer Science},
  volume={13715},
  pages={443--459},
  year={2022},
  publisher={Springer},
  doi={10.1007/978-3-031-26409-2_27},
  abstract={Convolutional neural networks lose fine-grained information through strided convolutions and pooling layers. This hurts badly on harder tasks such as low-resolution images and small objects. SPD-Conv replaces each strided convolution or pooling layer with a space-to-depth (SPD) layer, which rearranges every 2×2 block of pixels into channels without discarding anything, followed by a non-strided convolution. The block is general and drops into most CNN architectures. Applied to YOLOv5 (object detection) and ResNet (image classification), it clearly outperforms state-of-the-art models on low-resolution images and small objects.},
  arxiv={2208.03641},
  code={https://github.com/LabSAINT/SPD-Conv},
  preview={spd_conv.png},
  google_scholar_id={0izLItjtcgwC},
  bibtex_show={true},
  selected={true}
}

