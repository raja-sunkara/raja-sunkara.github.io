@mastersthesis{sunkara2023computer,
  abbr={M.S. Thesis},
  title={Computer Vision in Adverse Conditions: Small Objects, Low-Resolution Images, and Edge Deployment},
  author={Sunkara, Raja},
  school={Missouri University of Science and Technology},
  year={2023},
  abstract={Deep-learning computer vision models perform poorly under difficult conditions: small objects, low-resolution images, and deployment on low-end edge devices. This thesis studies these conditions and proposes a solution for each. For small objects and low-resolution images it introduces SPD-Conv, a CNN building block that replaces strided convolutions and pooling. For edge deployment it introduces YOGA, a lightweight object detector with two-phase feature learning and attention-based multi-scale feature fusion. Both are evaluated on COCO against state-of-the-art models, with code and models publicly available. Advised by Prof. Tie Luo.},
  html={https://scholarsmine.mst.edu/masters_theses/8159},
  bibtex_show={true}
}
